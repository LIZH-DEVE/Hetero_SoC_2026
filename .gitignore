# --- 1. 拦截所有 Vivado 自动生成的中间件 (无论在哪个层级) ---
**/HCS_SOC.gen/
**/HCS_SOC.runs/
**/HCS_SOC.sim/
**/HCS_SOC.cache/
**/HCS_SOC.hw/
**/HCS_SOC.ip_user_files/
**/HCS_SOC.tmp/
HCS_SOC/timing_triage/

# --- 2. 拦截全局噪音文件 ---
*.log
*.jou
*.pb
*.str
*.backup
*.wdb
*.vcd
.Xil/
**/.Xil/

# --- 3. 拦截编译二进制文件 ---
*.bit
*.bin
*.mcs
*.dcp

# --- 4. 显式保护源代码 (白名单) ---
!*.v
!*.sv
!*.vhd
!*.vhdl
!*.xdc
!*.xpr
!*.tcl
!*.py
!*.md
!*.hex
!HCS_SOC/sd_boot/ax7020_vendor_ps_hello_baseline/BOOT.BIN
!HCS_SOC/sd_boot/ax7020_vendor_ps_uart_baseline/BOOT.BIN
!HCS_SOC/sd_boot/ax7020_repo_design1_uart_baseline/BOOT.BIN
!HCS_SOC/sd_boot/ax7020_dma_mvp_smoke_system/BOOT.BIN

# --- 5. Upload hygiene: local caches, ad-hoc sim sandboxes, and root spillover ---
/.codex_sim/
/.pytest_cache/
/__pycache__/
**/__pycache__/
*.pyc
/.gen/
/.srcs/
/xsim.dir/
/tmp/
/tmp_*/
/\.claude/
/\.trae/
/\.wsdata/
/\.simlibs/
/\.rigel_lopper/
/vivado*.jou
/vivado*.log
/vivado_*.backup.jou
/vivado_*.backup.log
/hs_err_pid*.dmp
/board_*.txt
/HCS_SOC/_cbc_*
/HCS_SOC/_tmp_*
/HCS_SOC/*.pyc

# Local workspace state archive (do not publish)
/archive/root_temp_workdirs/local_workspace_state/


