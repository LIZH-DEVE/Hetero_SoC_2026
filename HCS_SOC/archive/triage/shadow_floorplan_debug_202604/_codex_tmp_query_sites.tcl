proc q {name} {
  set s [get_sites -quiet $name]
  if {[llength $s] == 0} {puts "$name=MISS"} else {puts "$name=OK"}
}
foreach n {
  SLICE_X20Y100 SLICE_X21Y100 SLICE_X22Y100 SLICE_X23Y100 SLICE_X24Y100 SLICE_X25Y100 SLICE_X26Y100
  SLICE_X67Y100 SLICE_X68Y100 SLICE_X79Y100 SLICE_X80Y100 SLICE_X113Y100 SLICE_X114Y100
  SLICE_X90Y50 SLICE_X91Y50 SLICE_X92Y50 SLICE_X93Y50 SLICE_X94Y50 SLICE_X95Y50 SLICE_X96Y50 SLICE_X97Y50 SLICE_X103Y65 SLICE_X106Y68
} { q $n }
exit
