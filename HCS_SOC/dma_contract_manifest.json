    "full_when_next_tail_equals_hw_head": true,
    "submit_full_rc": -5
  },
  "raw_copy": {
    "fifo_depth": 32,
    "fifo_memory": "BRAM",
    "tlast_width": 1,
    "required_axis_signals": [
      "TDATA",
      "TVALID",
      "TREADY",
      "TLAST"
    ]
  },
  "sequences": {
