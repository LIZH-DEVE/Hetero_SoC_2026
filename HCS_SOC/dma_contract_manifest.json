    "timeout_reference_clock_hz": 50000000,
    "timeout_reference_window_us": 100,
    "isr_rules": [
      "read_irq_status",
      "ack_done_pending",
      "schedule_bottom_half",
      "no_polling",
      "no_delay",
      "no_cache_invalidate",
      "no_memcmp",
      "no_long_uart_print"
    ],
    "completion_event_requires": [
      "payload_wb_b_handshake_complete",
      "actual_len_wb_b_handshake_complete",
      "csw_wb_b_handshake_complete"
    ],
    "completion_event_sequence": [
      "payload_wb_b_handshake_complete",
      "actual_len_wb_b_handshake_complete",
      "csw_wb_b_handshake_complete"
    ]
  },
  "stream_mode": {
    "ctrl_bit": "STREAM_TLAST",
    "len_semantics": {
      "fixed": "requested_len",
      "stream_tlast": "buffer_capacity"
    },
    "actual_len_fixed_equals_requested_len": true,
    "actual_len_stream_equals_received_bytes": true
  }
